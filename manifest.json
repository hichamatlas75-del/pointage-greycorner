{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "Grey Corner • Pointage & Présences",
  "short_name": "Pointage GC",
  "description": "Application de pointage géolocalisé et gestion des présences Grey Corner",
  "id": "pointage-greycorner",
  "start_url": "./index.html?mode=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#dde3eb",
  "theme_color": "#dde3eb",
  "orientation": "portrait-primary",
  "lang": "fr",
  "categories": ["business", "productivity"],
  "icons": [
    {
      "src": "images/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "images/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "images/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ]
}
